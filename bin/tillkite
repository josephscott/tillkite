#!/usr/bin/env php
<?php
declare( strict_types = 1 );

// Makes a new site: vendor/bin/tillkite new my-site
//
// Composer's bin proxy, vendor/bin/tillkite, says where the autoloader is.
// Run from a checkout of Tillkite, it's the checkout's own.

// For the command line only, so a checkout under a web server's document
// root can't run it for a visitor.
if ( PHP_SAPI !== 'cli' ) {
	http_response_code( 404 );
	exit;
}

$autoload = $GLOBALS['_composer_autoload_path'] ?? dirname( __DIR__ ) . '/vendor/autoload.php';
require $autoload;

exit( Tillkite\Starter::main( $_SERVER['argv'], $autoload, false ) );
