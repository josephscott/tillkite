{
	"name": "josephscott/tillkite",
	"description": "A small, fast PHP router that maps URLs to PHP files.",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">=8.4"
	},
	"require-dev": {
		"josephscott/phpcsfixer-config": "0.0.8",
		"phpstan/phpstan": "2.3.6",
		"pestphp/pest": "5.3.5",
		"nikic/fast-route": "1.3.1",
		"symfony/routing": "8.1.11",
		"wilaak/radix-router": "3.7.2"
	},
	"bin": [
		"bin/tillkite"
	],
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"config": {
		"classmap-authoritative": true,
		"optimize-autoloader": true,
		"allow-plugins": false
	}
}
